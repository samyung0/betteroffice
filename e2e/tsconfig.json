{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@betteroffice/fonts": ["../packages/fonts/src/index.ts"],
      "@betteroffice/fonts/progressive": ["../packages/fonts/src/progressive-entry.ts"],
      "@betteroffice/fonts-cjk": ["../packages/fonts-cjk/src/index.ts"],
      "@betteroffice/fonts-intl": ["../packages/fonts-intl/src/index.ts"],
      "@betteroffice/fonts-latin": ["../packages/fonts-latin/src/index.ts"]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}
