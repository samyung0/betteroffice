{
  "name": "@betteroffice/xlsx-i18n",
  "version": "0.5.1",
  "description": "Shared UI locale strings and types for the @betteroffice/xlsx React editor.",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./en": {
      "types": "./dist/en.d.mts",
      "import": "./dist/en.mjs",
      "default": "./dist/en.mjs"
    },
    "./zh-CN": {
      "types": "./dist/zh-CN.d.mts",
      "import": "./dist/zh-CN.mjs",
      "default": "./dist/zh-CN.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "xlsx",
    "editor",
    "i18n",
    "locales",
    "translations"
  ],
  "author": "OpenOOXML",
  "license": "Apache-2.0",
  "homepage": "https://betteroffice.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openooxml/betteroffice.git",
    "directory": "packages/xlsx-i18n"
  },
  "bugs": {
    "url": "https://github.com/openooxml/betteroffice/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
